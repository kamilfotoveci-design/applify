            <onclick>ToggleStereoMode</onclick>
            <selected>Integer.IsGreater(System.StereoscopicMode,0)</selected>
            <radiowidth>64</radiowidth>
            <radioheight>36</radioheight>
            <radioposy>13</radioposy>
            <textureradioonfocus colordiffuse="FFFFFFFF">orchard/controls143/switch-on-focus.png</textureradioonfocus>
