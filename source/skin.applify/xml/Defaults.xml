<?xml version='1.0' encoding='utf-8'?>
<includes>
  <default type="image">
    <texture />
    <aspectratio>stretch</aspectratio>
  </default>
  <default type="multiimage">
    <aspectratio align="center">scale</aspectratio>
    <fadetime>800</fadetime>
    <timeperimage>7000</timeperimage>
    <randomize>true</randomize>
  </default>
  <default type="label">
    <label />
    <align>left</align>
    <font>font13</font>
    <textcolor>white</textcolor>
    <disabledcolor>disabled</disabledcolor>
    <selectedcolor>selected</selectedcolor>
    <scroll>false</scroll>
    <scrollspeed>40</scrollspeed>
  </default>
  <default type="fadelabel">
    <align>left</align>
    <font>font13</font>
    <textcolor>white</textcolor>
    <disabledcolor>disabled</disabledcolor>
  </default>
  <default type="button">
    <texturefocus border="16" colordiffuse="FFFFFFFF">applify/clean101/row-focus.png</texturefocus>
    <texturenofocus border="16" colordiffuse="FFFFFFFF">applify/clean101/row.png</texturenofocus>
    <font>font13</font>
    <textcolor>white</textcolor>
    <disabledcolor>disabled</disabledcolor>
    <textoffsetx>7</textoffsetx>
    <aligny>center</aligny>
    <pulseonselect>no</pulseonselect>
  </default>
  <default type="togglebutton">
    <texturefocus border="16" colordiffuse="FFFFFFFF">applify/clean101/row-focus.png</texturefocus>
    <texturenofocus border="16" colordiffuse="FFFFFFFF">applify/clean101/row.png</texturenofocus>
    <alttexturefocus border="16" colordiffuse="FFFFFFFF">applify/clean101/row-focus.png</alttexturefocus>
    <alttexturenofocus border="16" colordiffuse="FFFFFFFF">applify/clean101/row.png</alttexturenofocus>
    <textcolor>white</textcolor>
    <font>font13</font>
    <disabledcolor>disabled</disabledcolor>
    <pulseonselect>no</pulseonselect>
  </default>
  <default type="textbox">
    <align>left</align>
    <textcolor>white</textcolor>
    <font>font13</font>
  </default>
  <default type="progress">
    <texturebg border="3">progress/texturebg_border_white.png</texturebg>
    <midtexture colordiffuse="button_focus" border="3">progress/texturebg_white.png</midtexture>
    <lefttexture />
    <righttexture />
    <overlaytexture />
  </default>
  <default type="spincontrol">
    <textureup colordiffuse="disabled">buttons/spinctrl/arrow-light-up.png</textureup>
    <texturedown colordiffuse="disabled">buttons/spinctrl/arrow-light-down.png</texturedown>
    <textureupfocus>buttons/spinctrl/arrow-light-up.png</textureupfocus>
    <texturedownfocus>buttons/spinctrl/arrow-light-down.png</texturedownfocus>
    <textureupdisabled colordiffuse="disabled">buttons/spinctrl/arrow-light-up.png</textureupdisabled>
    <texturedowndisabled colordiffuse="disabled">buttons/spinctrl/arrow-light-down.png</texturedowndisabled>
    <align>right</align>
    <width>77</width>
    <height>33</height>
    <font>font13</font>
    <reverse>yes</reverse>
    <textcolor>white</textcolor>
    <disabledcolor>disabled</disabledcolor>
    <subtype>text</subtype>
    <textoffsetx>-5</textoffsetx>
    <textoffsety>0</textoffsety>
    <pulseonselect>no</pulseonselect>
  </default>
  <default type="spincontrolex">
    <spinwidth>32</spinwidth>
    <spinheight>60</spinheight>
    <texturefocus border="16" colordiffuse="FFFFFFFF">applify/clean101/row-focus.png</texturefocus>
    <texturenofocus border="16" colordiffuse="FFFFFFFF">applify/clean101/row.png</texturenofocus>
    <textureup colordiffuse="disabled">buttons/spinctrl/arrow-light-up.png</textureup>
    <texturedown colordiffuse="disabled">buttons/spinctrl/arrow-light-down.png</texturedown>
    <textureupfocus>buttons/spinctrl/arrow-light-up.png</textureupfocus>
    <texturedownfocus>buttons/spinctrl/arrow-light-down.png</texturedownfocus>
    <textureupdisabled colordiffuse="disabled">buttons/spinctrl/arrow-light-up.png</textureupdisabled>
    <texturedowndisabled colordiffuse="disabled">buttons/spinctrl/arrow-light-down.png</texturedowndisabled>
    <font>font13</font>
    <textcolor>white</textcolor>
    <disabledcolor>disabled</disabledcolor>
    <textoffsetx>7</textoffsetx>
    <aligny>center</aligny>
    <reverse>yes</reverse>
    <pulseonselect>no</pulseonselect>
  </default>
  <default type="radiobutton">
    <radiowidth>64</radiowidth>
    <radioheight>36</radioheight>
    <textureradioonfocus colordiffuse="FFFFFFFF">orchard/controls143/switch-on-focus.png</textureradioonfocus>
    <textureradioonnofocus colordiffuse="FFFFFFFF">orchard/controls143/switch-on.png</textureradioonnofocus>
    <textureradioofffocus colordiffuse="FFFFFFFF">orchard/controls143/switch-off-focus.png</textureradioofffocus>
    <textureradiooffnofocus colordiffuse="FFFFFFFF">orchard/controls143/switch-off.png</textureradiooffnofocus>
    <textureradioondisabled colordiffuse="66FFFFFF">orchard/controls143/switch-on.png</textureradioondisabled>
    <textureradiooffdisabled colordiffuse="66FFFFFF">orchard/controls143/switch-off.png</textureradiooffdisabled>
    <texturefocus border="16" colordiffuse="FFFFFFFF">applify/clean101/row-focus.png</texturefocus>
    <texturenofocus border="16" colordiffuse="FFFFFFFF">applify/clean101/row.png</texturenofocus>
    <font>font13</font>
    <textcolor>white</textcolor>
    <disabledcolor>disabled</disabledcolor>
    <textoffsetx>7</textoffsetx>
    <align>left</align>
    <aligny>center</aligny>
    <pulseonselect>no</pulseonselect>
    <radioposy>0</radioposy>
  </default>
  <default type="colorbutton">
    <colorwidth>80</colorwidth>
    <colorheight>40</colorheight>
    <texturecolormask>buttons/color-button-box.png</texturecolormask>
    <texturecolordisabledmask colordiffuse="disabled">buttons/color-button-box.png</texturecolordisabledmask>
    <font>font13</font>
    <textcolor>white</textcolor>
    <disabledcolor>disabled</disabledcolor>
    <textoffsetx>7</textoffsetx>
    <align>left</align>
    <aligny>center</aligny>
    <pulseonselect>no</pulseonselect>
  </default>
  <default type="scrollbar">
    <texturesliderbackground colordiffuse="29FFFFFF">colors/white.png</texturesliderbackground>
    <texturesliderbar colordiffuse="FFAAAAAA">colors/white.png</texturesliderbar>
    <texturesliderbarfocus colordiffuse="button_focus">colors/white.png</texturesliderbarfocus>
    <textureslidernib />
    <textureslidernibfocus />
    <showonepage>false</showonepage>
    <orientation>vertical</orientation>
  </default>
  <default type="grouplist">
    <itemgap>0</itemgap>
    <align>left</align>
  </default>
  <default type="slider">
    <texturesliderbar colordiffuse="FFFFFFFF">orchard/controls144/slider-track.png</texturesliderbar>
    <texturesliderbardisabled colordiffuse="FFFFFFFF">orchard/controls144/slider-track-disabled.png</texturesliderbardisabled>
    <textureslidernib colordiffuse="FFFFFFFF">orchard/controls144/slider-thumb.png</textureslidernib>
    <textureslidernibfocus colordiffuse="FFFFFFFF">orchard/controls144/slider-thumb-focus.png</textureslidernibfocus>
    <textureslidernibdisabled colordiffuse="FFFFFFFF">orchard/controls144/slider-thumb-disabled.png</textureslidernibdisabled>
    <orientation>horizontal</orientation>
    <pulseonselect>false</pulseonselect>
  </default>
  <default type="sliderex">
    <textoffsetx>7</textoffsetx>
    <aligny>center</aligny>
    <texturefocus border="16" colordiffuse="FFFFFFFF">applify/clean101/row-focus.png</texturefocus>
    <texturenofocus border="16" colordiffuse="FFFFFFFF">applify/clean101/row.png</texturenofocus>
    <sliderwidth>220</sliderwidth>
    <sliderheight>36</sliderheight>
    <texturesliderbar colordiffuse="FFFFFFFF">orchard/controls144/slider-track.png</texturesliderbar>
    <texturesliderbardisabled colordiffuse="FFFFFFFF">orchard/controls144/slider-track-disabled.png</texturesliderbardisabled>
    <textureslidernib colordiffuse="FFFFFFFF">orchard/controls144/slider-thumb.png</textureslidernib>
    <textureslidernibfocus colordiffuse="FFFFFFFF">orchard/controls144/slider-thumb-focus.png</textureslidernibfocus>
    <textureslidernibdisabled colordiffuse="FFFFFFFF">orchard/controls144/slider-thumb-disabled.png</textureslidernibdisabled>
    <font>font13</font>
    <textcolor>white</textcolor>
    <disabledcolor>disabled</disabledcolor>
    <orientation>horizontal</orientation>
    <pulseonselect>false</pulseonselect>
  </default>
  <default type="mover">
    <texturefocus border="16" colordiffuse="FFFFFFFF">applify/clean101/row-focus.png</texturefocus>
    <texturenofocus border="16" colordiffuse="FFFFFFFF">applify/clean101/row.png</texturenofocus>
  </default>
  <default type="resize">
    <texturefocus border="16" colordiffuse="FFFFFFFF">applify/clean101/row-focus.png</texturefocus>
    <texturenofocus border="16" colordiffuse="FFFFFFFF">applify/clean101/row.png</texturenofocus>
  </default>
  <default type="edit">
    <texturefocus border="16" colordiffuse="FFFFFFFF">applify/clean101/row-focus.png</texturefocus>
    <texturenofocus border="16" colordiffuse="FFFFFFFF">applify/clean101/row.png</texturenofocus>
    <font>font13</font>
    <textcolor>white</textcolor>
    <disabledcolor>disabled</disabledcolor>
    <invalidcolor>invalid</invalidcolor>
    <textoffsetx>7</textoffsetx>
    <aligny>center</aligny>
    <pulseonselect>no</pulseonselect>
  </default>
</includes>
